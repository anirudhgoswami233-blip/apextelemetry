# OpenF1 Community tier needs NO key. Leave this unset and historical data
# (2023 onward) works immediately. Set it only for the Sponsor tier, which is
# what unlocks the live window and the streaming transports.
# OPENF1_API_KEY=

# APEX_CACHE_DIR=.apex-cache
# APEX_CORS_ORIGINS=http://localhost:3000

# Optional: narrative generation for the AI race engineer.
# Without it the endpoint still returns its full evidence bundle.
# ANTHROPIC_API_KEY=
